# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 로그인 페이지 주소 (지금 크롬 주소창에 보이는 로그인 화면 URL)
LOGIN_URL=https://edu.ueti.or.kr/main.do

# 비워두면 실행할 때 직접 입력받습니다 (비밀번호는 비워두는 것을 권장)
BOT_USER_ID=
BOT_USER_PW=

# 선택: 자동 탐지가 실패할 때만 CSS 셀렉터 지정 (예: #userId, input[name=passwd])
#  수강과정이 여러 개일 때 이어볼 과정명 일부 (비우면 목록의 첫 번째 과정)
COURSE_NAME=

ID_SELECTOR=
PW_SELECTOR=
SUBMIT_SELECTOR=

# 로그인 후 화면에 나타나는 문구
SUCCESS_TEXT=로그아웃
